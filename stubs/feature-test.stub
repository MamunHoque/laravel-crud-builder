use App\Models\User;
use Illuminate\Foundation\Testing\RefreshDatabase;
use Illuminate\Foundation\Testing\WithFaker;
use Tests\TestCase;

class {{ className }} extends TestCase
{
    use RefreshDatabase, WithFaker;

    protected User $user;

    protected function setUp(): void
    {
        parent::setUp();
        
        $this->user = User::factory()->create();
        $this->actingAs($this->user, 'api');
    }

    /** @test */
    public function it_can_list_{{ modelVariable }}s()
    {
        {{ modelName }}::factory()->count(3)->create();

        $response = $this->getJson(route('{{ routePrefix }}{{ resourceName }}.index'));

        $response->assertStatus(200)
                 ->assertJsonStructure([
                     'status',
                     'data',
                     'message'
                 ]);
    }

    /** @test */
    public function it_can_create_{{ modelVariable }}()
    {
        $data = {{ factoryData }};

        $response = $this->postJson(route('{{ routePrefix }}{{ resourceName }}.store'), $data);

        $response->assertStatus(201)
                 ->assertJsonStructure([
                     'status',
                     'data' => [
                         'id',
                         // Add other expected fields
                     ],
                     'message'
                 ]);

        $this->assertDatabaseHas('{{ tableName }}', $data);
    }

    /** @test */
    public function it_can_show_{{ modelVariable }}()
    {
        ${{ modelVariable }} = {{ modelName }}::factory()->create();

        $response = $this->getJson(route('{{ routePrefix }}{{ resourceName }}.show', ${{ modelVariable }}->id));

        $response->assertStatus(200)
                 ->assertJsonStructure([
                     'status',
                     'data' => [
                         'id',
                         // Add other expected fields
                     ],
                     'message'
                 ]);
    }

    /** @test */
    public function it_can_update_{{ modelVariable }}()
    {
        ${{ modelVariable }} = {{ modelName }}::factory()->create();
        $updateData = {{ updateData }};

        $response = $this->putJson(route('{{ routePrefix }}{{ resourceName }}.update', ${{ modelVariable }}->id), $updateData);

        $response->assertStatus(200)
                 ->assertJsonStructure([
                     'status',
                     'data' => [
                         'id',
                         // Add other expected fields
                     ],
                     'message'
                 ]);

        $this->assertDatabaseHas('{{ tableName }}', array_merge(['id' => ${{ modelVariable }}->id], $updateData));
    }

    /** @test */
    public function it_can_delete_{{ modelVariable }}()
    {
        ${{ modelVariable }} = {{ modelName }}::factory()->create();

        $response = $this->deleteJson(route('{{ routePrefix }}{{ resourceName }}.destroy', ${{ modelVariable }}->id));

        $response->assertStatus(200);
        $this->assertDatabaseMissing('{{ tableName }}', ['id' => ${{ modelVariable }}->id]);
    }

    /** @test */
    public function it_returns_404_for_non_existent_{{ modelVariable }}()
    {
        $response = $this->getJson(route('{{ routePrefix }}{{ resourceName }}.show', 999));

        $response->assertStatus(500); // Assuming your error handling returns 500 for not found
    }

